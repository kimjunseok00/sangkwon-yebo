# 이 파일을 .env로 복사해서 쓴다. .env는 저장소에 올리지 않는다.

# 1이면 위험 이유 설명을 가짜 문장 틀로 만든다(API 키 불필요). Gemini를 쓰려면 0.
USE_MOCK=1

# Google AI Studio에서 각자 발급받은 키
GEMINI_API_KEY=

# 모델 ID. AI Studio에서 무료로 쓸 수 있는 실제 ID를 확인하고 맞춘다.
GEMINI_MODEL=gemini-3.8-flash

# 금융기관용 API 키(쉼표로 여러 개). 예: API_KEYS=demo-bank-1,demo-bank-2
# 발표용 시연 키도 여기에만 둔다.
API_KEYS=
